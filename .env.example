# Kinesis environment — copy to .env (.env is gitignored).
POLYGON_API_KEY=your_polygon_key
# DATABASE_URL defaults to the compose service; override for prod.

# ── Celery (step 3) — broker/backend default to the compose `redis` service ──
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Digest (step 6) — twice-daily Gmail heartbeat ──
# Beat hours are ET-clock (TZ America/New_York); defaults 2 & 14 => 08:30 & 20:30 Prague.
# DIGEST_AM_HOUR=2
# DIGEST_PM_HOUR=14
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # Gmail App Password (16 chars); NEVER commit
# DIGEST_TO=you@gmail.com                  # recipient(s); comma-separated

